# Optional path to a specific Python interpreter for the dev sidecar.
WINGMAN_PYTHON_BIN=

# Groq API key. This one key covers both transcription and answers, and the
# free tier is normally enough to run a full interview at no cost.
# Can also be pasted into the app UI, where it is stored in the OS keychain.
GROQ_API_KEY=

# Optional. Only needed if you switch the transcription engine to Deepgram,
# which is lower latency but paid and billed for connection time.
DEEPGRAM_API_KEY=
